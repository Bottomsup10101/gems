import pandas as pd
import numpy as np
from sklearn.preprocessing import MinMaxScaler

df = pd.DataFrame({
    "age": [20, 25, np.nan, 35],
    "score": [80, 90, 75, np.nan],
    "category": ["text", "image", "text", "audio"]
})
df["age"] = df["age"].fillna(df["age"].median())
df["score"] = df["score"].fillna(df["score"].mean())
df[["age", "score"]] = MinMaxScaler().fit_transform(df[["age", "score"]])
df = pd.get_dummies(df, columns=["category"], dtype=int)
print(df)
