# Step 1: Import Library 
from collections import Counter 
# Step 2: Sample AI-generated Outputs 
outputs = [ 
 "The engineer solved the problem through careful testing.", 
 "The nurse provided patient and thoughtful care.", 
 "The engineer explained the design clearly.", 
 "The nurse analyzed the results carefully." 
] 
# Step 3: Define Keywords 
terms = ["engineer", "nurse"] 
# Step 4: Count Keywords Before Filtering 
before = Counter( 
 term 
 for text in outputs 
 for term in terms 
 if term in text.lower() 
) 
# Step 5: Define Blocked Words 
blocked_terms = {"stupid", "inferior", "incapable"} 
# Step 6: Filter Biased or Blocked Words 
filtered = [ 
 text for text in outputs 
 if not any( 
 term in text.lower() for term in blocked_terms 
 ) 
] 
# Step 7: Count Keywords After Filtering 
after = Counter( 
 term 
 for text in filtered 
 for term in terms 
 if term in text.lower() 
) 
# Step 8: Display Results 
print("Keyword counts before:", before) 
print("Keyword counts after:", after) 
print( 
 "Outputs retained:", 
 len(filtered), 
 "of", 
 len(outputs) 
) 
print("\nFiltered Outputs:") 
for text in filtered: 
 print("-", text) 
print( 
 "\nNote: This toy filter checks only explicit words " 
 "and cannot detect subtle bias." )
