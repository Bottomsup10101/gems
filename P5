%pip -q install --upgrade diffusers transformers accelerate
import os
try:
  import torch
  from diffusers import DDPMPipeline
except ImportError:
  print("\n--- Restarting runtime to apply updated package versions... -
  --\n")
  os.kill(os.getpid(), 9)
device = "cuda" if torch.cuda.is_available() else "cpu"
model_id = "google/ddpm-cifar10-32"
# Load the pre-trained model
pipe = DDPMPipeline.from_pretrained(model_id).to(device)
# Generate images
images = pipe(batch_size=2, num_inference_steps=50).images
# Display the images
display(images[0])
display(images[1])
